<Window x:Class="PinyinPlus.Server.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova 输入法 - 设置"
        Width="420" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF55D8FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFB8C2CC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF172330"/>
            <Setter Property="Foreground" Value="#FFD8DEE4"/>
            <Setter Property="BorderBrush" Value="#FF2A3644"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="#FF2A3644" BorderThickness="1">
        <Border.Background>
            <!-- Nova 品牌：深夜蓝灰渐变 -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0C1117" Offset="0"/>
                <GradientStop Color="#FF172330" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题：Nova N 标识 + 名称 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,4">
                <Image Source="pack://application:,,,/Assets/Nova.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Nova 输入法" FontSize="19" FontWeight="Bold" Foreground="#FFEAF6FF"/>
                    <TextBlock Text="Pinyin IME · 设置" FontSize="11" Foreground="#FF7A828E" Margin="1,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 外观设置 -->
            <TextBlock Grid.Row="1" Text="外观" Style="{StaticResource SectionTitle}"/>

            <!-- 每页候选数 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="每页候选数" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PageSizeCombo" Grid.Column="1"
                          SelectedIndex="4">
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>
            </Grid>

            <!-- 候选字大小 -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="候选字大小" Style="{StaticResource FieldLabel}"/>
                <Slider x:Name="FontSizeSlider" Grid.Column="1"
                        Minimum="12" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True"
                        Width="160" VerticalAlignment="Center"/>
                <TextBlock x:Name="FontSizeValue" Grid.Column="2" Text="15"
                           Foreground="#FF55D8FF" FontSize="13" TextAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 皮肤 -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="皮肤主题" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0C1117" Offset="0"/>
                                <GradientStop Color="#FF9A6BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Nova 深蓝灰" Foreground="#FFB8C2CC" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 数据与学习 -->
            <TextBlock Grid.Row="5" Text="数据与学习" Style="{StaticResource SectionTitle}"/>

            <!-- 自学习开关 -->
            <Grid Grid.Row="6">
                <CheckBox x:Name="LearningCheck" Content="启用选词自学习（记忆新词、造词入库）"
                          Foreground="#FFB8C2CC" FontSize="13" VerticalAlignment="Center"
                          IsChecked="True"/>
            </Grid>

            <!-- 大字库模式（含 4 万+ 生僻字） -->
            <Grid Grid.Row="7" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox x:Name="BigDictCheck" Content="大字库模式（含 4 万+ 生僻字）"
                              Foreground="#FFB8C2CC" FontSize="13" VerticalAlignment="Center"
                              IsChecked="False"/>
                    <TextBlock Text="启用后可用拼音查到龘、靁、𠀀 等扩展区生僻字；生僻字排在候选末尾，需翻页。"
                               FontSize="11" Foreground="#FF7A828E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 繁体输出（OpenCC 输出层转换，词库恒为简体） -->
            <Grid Grid.Row="8" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox x:Name="TraditionCheck" Content="繁体输出（选字上屏为繁体）"
                              Foreground="#FFB8C2CC" FontSize="13" VerticalAlignment="Center"
                              IsChecked="False"/>
                    <TextBlock Text="启用后候选与上屏文本转为繁体（后面→後面、干部→幹部）；词库仍存简体，切换无残留。"
                               FontSize="11" Foreground="#FF7A828E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 搜狗式拆字（;=第1字、'=第2字，仅多字词） -->
            <Grid Grid.Row="9" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox x:Name="CharSelCheck" Content="搜狗式拆字（;=第1字，'=第2字）"
                              Foreground="#FFB8C2CC" FontSize="13" VerticalAlignment="Center"
                              IsChecked="True"/>
                    <TextBlock Text="选中多字候选词时按 ; 上屏第 1 字、按 ' 上屏第 2 字（如 两个 可拆出 两/个）；单字候选回落普通标点。"
                               FontSize="11" Foreground="#FF7A828E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 词库导入/导出 -->
            <Grid Grid.Row="10" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="用户词库" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ImportDictButton" Content="导入词库..."
                            Width="110" Height="30" Margin="0,0,8,0" Click="OnImportDictClick" Cursor="Hand"
                            Background="#FF1E2A38" Foreground="#FFD8DEE4" BorderBrush="#FF2A3644" BorderThickness="1"/>
                    <Button x:Name="ExportDictButton" Content="导出用户词库..."
                            Width="132" Height="30" Click="OnExportDictClick" Cursor="Hand"
                            Background="#FF1E2A38" Foreground="#FFD8DEE4" BorderBrush="#FF2A3644" BorderThickness="1"/>
                </StackPanel>
            </Grid>

            <!-- 提示 -->
            <TextBlock Grid.Row="11" Text="提示：修改即时保存，候选窗热生效，无需重启。" 
                       FontSize="11" Foreground="#FF7A828E" VerticalAlignment="Bottom" TextWrapping="Wrap" Margin="0,16,0,0"/>

            <!-- 按钮 -->
            <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ShortcutsButton" Content="快捷键" Width="88" Height="34" Margin="0,0,10,0"
                        Background="#FF1E2A38" Foreground="#FFD8DEE4" BorderBrush="#FF2A3644"
                        BorderThickness="1" Click="OnShortcutsClick" Cursor="Hand"/>
                <Button x:Name="CloseButton" Content="关闭" Width="88" Height="34" Margin="0,0,10,0"
                        Background="#FF1E2A38" Foreground="#FFD8DEE4" BorderBrush="#FF2A3644"
                        BorderThickness="1" Click="OnCloseClick" Cursor="Hand"/>
                <Button x:Name="SaveButton" Content="保存" Width="88" Height="34"
                        Click="OnSaveClick" Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF55D8FF" Offset="0"/>
                            <GradientStop Color="#FF9A6BFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="#FF0C1117"/>
                    </Button.Foreground>
                    <Button.BorderBrush>
                        <SolidColorBrush Color="Transparent"/>
                    </Button.BorderBrush>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
